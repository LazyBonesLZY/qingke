<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- All vendors share one foreground Live refresh service and notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 保活用：电池白名单（防后台被缓存）+ 精确闹钟（上下课整点准时）。
         USE_EXACT_ALARM 是日历/课表类应用的自动授予权限（33+），ColorOS 上
         SCHEDULE_EXACT_ALARM 的 appops 默认不给且 canScheduleExactAlarms()
         谎报 true，setExact 静默降级非精确后被 OEM adjustment 冻结数天。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <queries>
        <package android:name="com.xiaomi.aischedule" />
        <package android:name="com.miui.voiceassist" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name="cn.edu.gzus.qingke.QingkeApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qingke"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name="cn.edu.gzus.qingke.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Qingke">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="cn.edu.gzus.qingke.JwxtWebActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Qingke" />
        <receiver
            android:name="cn.edu.gzus.qingke.LiveDismissReceiver"
            android:exported="false" />
        <receiver
            android:name="cn.edu.gzus.qingke.LiveTickReceiver"
            android:exported="false" />
        <!-- Active only during a reminder window; minute and stage updates share one timer. -->
        <service
            android:name="cn.edu.gzus.qingke.LiveForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持上课进度通知与胶囊倒计时按分钟刷新" />
        </service>
        <receiver
            android:name="cn.edu.gzus.qingke.widget.WidgetTickReceiver"
            android:exported="false" />
        <receiver
            android:name="cn.edu.gzus.qingke.widget.WidgetClockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="cn.edu.gzus.qingke.widget.DayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_day_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_info" />
        </receiver>
        <receiver
            android:name="cn.edu.gzus.qingke.widget.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <receiver
            android:name="cn.edu.gzus.qingke.widget.SquareWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_square_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_square_info" />
        </receiver>
        <receiver
            android:name="cn.edu.gzus.qingke.widget.MonthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_info" />
        </receiver>
        <activity
            android:name="cn.edu.gzus.qingke.widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Qingke">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
